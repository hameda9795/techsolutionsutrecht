# Google Business Profile API uses OAuth 2.0; a browser API key is not enough.
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
# Must also be registered as an authorised redirect URI in Google Cloud.
GOOGLE_BUSINESS_REDIRECT_URI=http://127.0.0.1:53682/oauth2callback

# Required in production. Locally, the auth command stores this in the ignored
# .google-business-profile-token.json file.
GOOGLE_BUSINESS_REFRESH_TOKEN=

# Optional when the connected Google account has exactly one account/location.
# Add the numeric IDs when more than one is available.
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# Fallback while Business Profile API access is pending approval (instant to
# set up: no OAuth, no review process). Used only when the vars above are
# missing or the Business Profile request fails. Shows up to 5 Google reviews.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
